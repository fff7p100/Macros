from pynput import keyboard
import time

controller = keyboard.Controller()
bloqueo = False

def on_press(key):
    global bloqueo
    if bloqueo:
        return

    try:
        if hasattr(key, 'char') and key.char == '1':
            bloqueo = True

           
            for _ in range(2):
                controller.press(' ')
                controller.release(' ')

           
            time.sleep(0.01)
            bloqueo = False
    except AttributeError:
        pass

print("Script activo (Modo Ultra Rápido). Presiona 1 (Ctrl+C para salir).")
with keyboard.Listener(on_press=on_press) as listener:
    listener.join()
